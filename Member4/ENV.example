# Copy to .env in the backend service. Never commit the real .env file.
# Placeholders only — no real keys are included in this package.

# AI provider — required for real (non-fallback) post-disaster report generation.
# ai/postDisasterAgent/agent.js calls the Anthropic API directly.
ANTHROPIC_API_KEY=

# Firebase Admin SDK (backend). If the main project already initializes
# firebase-admin elsewhere, these may already be set — do not duplicate.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Frontend (Vite-style; adjust prefix if the main project uses CRA's
# REACT_APP_ prefix instead — see frontend/authority/services/api.js).
VITE_API_BASE_URL=/api
